# Copy this file to .env and fill in your real key. Never commit the real .env file.
# If you already set this up for Halal Scout, it's the exact same key/value.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gmail SMTP — used by send_email_to_subscribers to notify subscribers. GMAIL_APP_PASSWORD
# is a 16-character App Password (not your regular Gmail password), generated at
# https://myaccount.google.com/apppasswords — this requires 2-Step Verification to be
# enabled on the Google account first. See README.md.
GMAIL_ADDRESS=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
